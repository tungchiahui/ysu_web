# 留空时使用 content-source.json。仓库改名或换账号只需调整地址。
CONTENT_REPOSITORY=
CONTENT_REF=

# 本地维护内容时指定内容仓库目录；设置后不访问远程。
# CONTENT_LOCAL_PATH=../ysu_content

# 私有 HTTPS 仓库使用只读 token；也可使用 SSH 地址和已有 SSH 凭据。
# CONTENT_GIT_TOKEN=

# 以下为 EO Functions 运行时配置；不要添加 NUXT_PUBLIC_ 前缀。
# 未准备好飞书表格时保持关闭，不会展示模拟任务。
DASHBOARD_ENABLED=false
DASHBOARD_PUBLIC=false
DASHBOARD_ACCESS_CODE=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
# 可选：限定读取某个视图。
FEISHU_BITABLE_VIEW_ID=
# 可选：实际字段不同名时使用 JSON 映射，详见 docs/任务看板接入.md。
FEISHU_FIELD_MAP=
# 可选：最多5个公开仓库，逗号分隔；留空则不显示研发动态。
DASHBOARD_GITHUB_REPOS=
DASHBOARD_GITHUB_TOKEN=
