{
  "name": "ysu-yanying-website",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "wiki:check": "node scripts/wiki-check.mjs",
    "content:sync": "node --env-file-if-exists=.env scripts/sync-content.mjs",
    "predev": "npm run content:sync && npm run members:check && npm run news:check",
    "prebuild": "npm run content:sync && npm run members:check && npm run wiki:check && npm run news:check",
    "pregenerate": "npm run content:sync && npm run members:check && npm run wiki:check && npm run news:check",
    "preview": "nuxt preview",
    "members:check": "node scripts/member-check.mjs",
    "members:test": "node --experimental-strip-types --test tests/members.test.mjs",
    "competitions:test": "node --experimental-strip-types --test tests/competitions.test.mjs",
    "dashboard:test": "node --test tests/dashboard.test.mjs",
    "dashboard:preview": "node scripts/dashboard-preview.mjs",
    "wiki:test": "node --test tests/wiki-authors.test.mjs",
    "wiki:output-check": "node --experimental-strip-types scripts/wiki-output-check.mjs",
    "wiki:output-test": "node --experimental-strip-types --test tests/wiki-output.test.mjs",
    "news:check": "node scripts/news-check.mjs",
    "news:test": "node --test tests/news.test.mjs"
  },
  "dependencies": {
    "@nuxt/content": "^3.13.0",
    "better-sqlite3": "^12.9.0",
    "medium-zoom": "^1.1.0",
    "nuxt": "^4.4.0",
    "pinyin-pro": "^3.28.1",
    "vue": "^3.5.0",
    "yaml": "2.9.0"
  }
}
