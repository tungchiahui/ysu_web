{
  "name": "ysu-yanying-website",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "wiki:check": "node scripts/wiki-check.mjs",
    "content:sync": "node --env-file-if-exists=.env scripts/sync-content.mjs",
    "predev": "npm run content:sync",
    "prebuild": "npm run content:sync && npm run wiki:check",
    "pregenerate": "npm run content:sync && npm run wiki:check",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "@nuxt/content": "^3.13.0",
    "better-sqlite3": "^12.9.0",
    "medium-zoom": "^1.1.0",
    "nuxt": "^4.4.0",
    "pinyin-pro": "^3.28.1",
    "vue": "^3.5.0"
  }
}
